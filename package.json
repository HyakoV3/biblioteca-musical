{
  "name": "bibliotecamusical",
  "version": "0.3.8",
  "description": "App não oficial para músicos em treino",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/karaoke.mjs",
    "tezcat": "tools/tezcat.sh",
    "tauri": "tauri"
  },
  "dependencies": {
    "@sapphi-red/web-noise-suppressor": "^0.4.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-http": "^2.9.0",
    "fflate": "^0.8.3",
    "pitchy": "^4.1.0",
    "smplr": "^1.2.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "fake-indexeddb": "^6.2.8",
    "svelte": "^5.59.1",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.1"
  },
  "imports": {
    "#lib/*": {
      "default": [
        "./src/lib/*",
        "./src/lib/*.ts",
        "./src/lib/*.js"
      ]
    }
  }
}
